                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "const order = $json;\nconst paymentDate = new Date(order.date_confirmed * 1000).toISOString().slice(0, 10);\n\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027advance\u0027,\n    issue_date: paymentDate,\n    sell_date: paymentDate,\n    payment_to: paymentDate,\n    buyer_name: order.delivery_fullname || order.invoice_fullname,\n    buyer_tax_no: order.invoice_nip || \u0027\u0027,\n    buyer_post_code: order.invoice_postcode || \u0027\u0027,\n    buyer_city: order.invoice_city || \u0027\u0027,\n    buyer_street: order.invoice_address || \u0027\u0027,\n    buyer_country: order.invoice_country_code || \u0027PL\u0027,\n    buyer_email: order.email || \u0027\u0027,\n    positions: [{\n      name: `Zaliczka do zamówienia nr ${order.order_id}`,\n      tax: 23,\n      total_price_gross: order.order_total_gross || 0,\n      quantity: 1\n    }],\n    description: `Zaliczka 100% do zamówienia BaseLinker nr ${order.order_id}`,\n    payment_type: \u0027transfer\u0027,\n    status: \u0027paid\u0027\n  },\n  _order_id: order.order_id\n};\n\nreturn [{ json: payload }];"
                                     },
                      "notes":  "Mapowanie BL → Fakturownia."
                  },
