                      "id":  "check-task-exists",
                      "name":  "Check Task Exists",
                      "type":  "n8n-nodes-base.if",
                      "position":  [
                                       448,
                                       0
                                   ],
                      "typeVersion":  2.2
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const tasks = $input.first().json.tasks || [];\nconst today = new Date().toISOString().split(\u0027T\u0027)[0];\n\n// Znajdź dzisiejszy task\nlet todayTask = tasks.find(t =\u003e t.name.includes(today)) || tasks[0];\n\nif (!todayTask) {\n  return [{json: {error: true, message: \u0027No task found\u0027}}];\n}\n\n// Pobierz checklisty\nconst checklists = todayTask.checklists || [];\nlet allItems = [];\n\nfor (const checklist of checklists) {\n  for (const item of checklist.items || []) {\n    if (!item.name.includes(\u0027───\u0027)) {\n      allItems.push(item.name);\n    }\n  }\n}\n\n// Podziel na taski i nawyki\nconst taskItems = allItems.filter(i =\u003e !i.startsWith(\u0027🎧\u0027) \u0026\u0026 !i.startsWith(\u0027📚\u0027));\nconst habitItems = allItems.filter(i =\u003e i.startsWith(\u0027🎧\u0027) || i.startsWith(\u0027📚\u0027));\n\n// Przygotuj wiadomość\nlet message = \u0027🌙 *Podsumowanie dnia!*\\n\\n\u0027;\nmessage += \u0027📋 *Zaplanowane taski:*\\n\u0027;\nfor (const item of taskItems) {\n  message += `• ${item}\\n`;\n}\nmessage += \u0027\\n🎧 *Nawyki:*\\n\u0027;\nfor (const item of habitItems) {\n  message += `• ${item}\\n`;\n}\nmessage += \u0027\\n_Wpisz wykonane (po przecinku):_\\n\u0027;\nmessage += \u0027_np. 1, 2, 3_\\n\u0027;\nmessage += \u0027_lub \"wszystko\" jeśli wszystko zrobione_\u0027;\n\nreturn [{\n  json: {\n    message: message,\n    taskId: todayTask.id,\n    taskName: todayTask.name\n  }\n}];"
                                     },
