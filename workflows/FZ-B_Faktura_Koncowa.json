                                       -720,
                                       400
                                   ],
                      "notes":  "True=była zaliczka → final. False=nie było → vat."
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const order = $json.orders[0];\nconst advanceInvoiceId = order.extra_field_1;\nconst today = new Date().toISOString().slice(0, 10);\n\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027final\u0027,\n    from_invoice_id: parseInt(advanceInvoiceId, 10),\n    issue_date: today,\n    sell_date: today,\n    payment_to: today,\n    buyer_name: order.delivery_fullname || order.invoice_fullname,\n    description: `Rozliczenie zaliczki do zamówienia ${order.order_id}`,\n    status: \u0027paid\u0027\n  },\n  _order_id: order.order_id\n};\n\nreturn [{ json: payload }];"
                                     },
                      "id":  "build-final",
                      "name":  "Build payload (faktura końcowa)",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -480,
                                       304
                                   ],
                      "notes":  "kind=final + from_invoice_id → wyzerowana."
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const order = $json.orders[0];\nconst today = new Date().toISOString().slice(0, 10);\n\nconst positions = (order.products || []).map(p =\u003e ({\n  name: p.name,\n  tax: 23,\n  total_price_gross: p.price_brutto,\n  quantity: p.quantity\n}));\n\nif (positions.length === 0) {\n  positions.push({\n    name: `Zamówienie nr ${order.order_id}`,\n    tax: 23,\n    total_price_gross: order.order_total_gross || 0,\n    quantity: 1\n  });\n}\n\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027vat\u0027,\n    issue_date: today,\n    sell_date: today,\n    payment_to: today,\n    buyer_name: order.delivery_fullname || order.invoice_fullname,\n    buyer_tax_no: order.invoice_nip || \u0027\u0027,\n    buyer_post_code: order.invoice_postcode || \u0027\u0027,\n    buyer_city: order.invoice_city || \u0027\u0027,\n    buyer_street: order.invoice_address || \u0027\u0027,\n    buyer_country: order.invoice_country_code || \u0027PL\u0027,\n    buyer_email: order.email || \u0027\u0027,\n    positions: positions,\n    payment_type: \u0027transfer\u0027,\n    status: \u0027paid\u0027\n  },\n  _order_id: order.order_id\n};\n\nreturn [{ json: payload }];"
                                     },
