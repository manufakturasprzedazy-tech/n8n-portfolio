                                         "jsCode":  "// Znajdz draft agenta nalezacy do tego samego watku co wyslana odpowiedz.\nconst tid = (($(\u0027parsuj-akcje\u0027).first().json || {}).value || {}).tid || \u0027\u0027;\nconst out = [];\nif (!tid) return out;\nfor (const it of $input.all()) {\n  const d = it.json || {};\n  const dThread = (d.message \u0026\u0026 d.message.threadId) || d.threadId || \u0027\u0027;\n  const draftId = d.id || \u0027\u0027;\n  if (draftId \u0026\u0026 dThread === tid) out.push({ json: { draftId: draftId } });\n}\nreturn out;"
