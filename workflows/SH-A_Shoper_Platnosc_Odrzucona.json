                  {
                      "id":  "buduj-payload",
                      "name":  "Buduj-Payload",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -120,
                                       400
                                   ],
                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "// BL zamowienie (dane do faktury, produkty, email)\nconst bl = $input.first().json;\n// Shoper zamowienie (numer sklep, kwoty)\nconst shop = $(\u0027Filtruj-Kandydatow\u0027).first().json;\n\nfunction toLocalISO(d) {\n  const fmt = new Intl.DateTimeFormat(\u0027en-CA\u0027, { timeZone: \u0027Europe/Warsaw\u0027, year: \u0027numeric\u0027, month: \u00272-digit\u0027, day: \u00272-digit\u0027 });\n  return fmt.format(d);\n}\nconst today = new Date();\nconst issueDate = toLocalISO(today);\nconst due = new Date(today.getTime() + 14 * 24 * 60 * 60 * 1000);\nconst paymentTo = toLocalISO(due);\n\nconst buyerName = (bl.invoice_company || \u0027\u0027).trim() || bl.invoice_fullname || bl.delivery_fullname || \u0027Klient\u0027;\nconst buyerEmail = bl.email || bl.delivery_email || bl.invoice_email || \u0027\u0027;\n\nconst productsList = (bl.products || [])\n  .map(p =\u003e \u0027- \u0027 + p.name + \u0027 (\u0027 + p.quantity + \u0027 szt)\u0027)\n  .join(\u0027\\n\u0027);\n\nconst shopOrderNumber = shop.order_id; // numer sklep Shoper\n\nconst positions = (bl.products || []).map(p =\u003e ({\n  name: p.name,\n  tax: 23,\n  quantity: p.quantity,\n  quantity_unit: \u0027szt\u0027,\n  total_price_gross: Number(p.price_brutto) * Number(p.quantity)\n}));\n\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027proforma\u0027,\n    place: \u0027Radzionkow\u0027,\n    issue_date: issueDate,\n    sell_date: issueDate,\n    payment_to: paymentTo,\n    buyer_name: buyerName,\n    buyer_tax_no: bl.invoice_nip || \u0027\u0027,\n    buyer_post_code: bl.invoice_postcode || \u0027\u0027,\n    buyer_city: bl.invoice_city || \u0027\u0027,\n    buyer_street: bl.invoice_address || \u0027\u0027,\n    buyer_country: bl.invoice_country_code || \u0027PL\u0027,\n    buyer_email: buyerEmail,\n    description: \u0027Proforma za zamowienie \u0027 + shopOrderNumber + \u0027 - platnosc online nieudana\u0027,\n    internal_note: \u0027Shoper odrzut / BL: \u0027 + bl.order_id + \u0027 / Shoper: \u0027 + shopOrderNumber,\n    payment_type: \u0027transfer\u0027,\n    positions: positions\n  },\n  _shop_order_number: shopOrderNumber,\n  _products_list: productsList,\n  _email: buyerEmail,\n  _bl_order_id: bl.order_id\n};\n\nreturn [{ json: payload }];"
                                     },
                      "notes":  "Mapping BL+Shoper -\u003e Fakturownia. kind=proforma, payment_to=+14 dni, VAT 23%, positions z BL.products. internal_note z BL ID + Shoper ID jako slad audytowy."
                  },
