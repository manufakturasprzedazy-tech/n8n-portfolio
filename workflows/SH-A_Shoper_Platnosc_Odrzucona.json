                                         "jsCode":  "const orders = $input.first().json.orders || [];\nif (orders.length === 0) {\n  const shopId = $(\u0027Filtruj-Kandydatow\u0027).first().json.order_id;\n  throw new Error(\u0027BL getOrders zwrocil pusta liste dla Shoper order_id=\u0027 + shopId + \u0027 - sprawdz sync BL-Shoper\u0027);\n}\nreturn [{ json: orders[0] }];"
