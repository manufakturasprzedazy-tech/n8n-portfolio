                  {
                      "id":  "filtruj-kandydatow",
                      "name":  "Filtruj-Kandydatow",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -1080,
                                       400
                                   ],
                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "// Wejscie: response Shopera (lista zamowien lub paginated container)\nconst raw = $input.first().json;\n// Shoper API zwraca: { list: [...], count: N, pages: M } albo bezposrednio [...]\nconst orders = Array.isArray(raw) ? raw : (raw.list || []);\n\nconst DELAY_HOURS = 24; // TODO_DELAY_HOURS - po ilu godzinach od utworzenia uznajemy \u0027nieoplacone\u0027\nconst nowMs = Date.now();\nconst delayMs = DELAY_HOURS * 60 * 60 * 1000;\n\nconst candidates = orders.filter(o =\u003e {\n  // Heurystyka: zamowienie online nieoplacone, link platnosci aktywny, wystarczajaco stare\n  if (o.is_paid !== false) return false;\n  if (parseFloat(o.paid) !== 0) return false;\n  if (!o.payment_url || o.payment_url === \u0027\u0027) return false;\n  if (parseInt(o.payment_id, 10) !== 3) return false; // tylko Autopay\n  // Wiek zamowienia\n  const orderDate = new Date(o.date.replace(\u0027 \u0027, \u0027T\u0027) + \u0027+02:00\u0027).getTime();\n  if ((nowMs - orderDate) \u003c delayMs) return false;\n  return true;\n});\n\nreturn candidates.map(o =\u003e ({ json: o }));"
                                     },
                      "notes":  "Filtr kandydatow: is_paid=false, paid=0.00, payment_url≠\u0027\u0027, payment_id=3 (Autopay), wiek \u003e DELAY_HOURS godzin. Default 24h. Zwraca kazdego kandydata jako osobny item n8n -\u003e reszta workflow iteruje po nich."
                  },
