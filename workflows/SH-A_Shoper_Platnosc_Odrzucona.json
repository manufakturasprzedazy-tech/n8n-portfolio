                                   ],
                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "const shop = $(\u0027Filtruj-Kandydatow\u0027).first().json;\nconst shopId = shop.order_id || \u0027UNKNOWN\u0027;\nconst item = $input.first();\nconst errObj = item.error || (item.json \u0026\u0026 item.json.error) || item.json;\nconst errMsg = (errObj \u0026\u0026 errObj.message) || (typeof errObj === \u0027string\u0027 ? errObj : JSON.stringify(errObj || {}).slice(0, 500));\nconst execId = $execution.id;\n\nconst taskName = \u0027[SH-A BLAD] Proforma odrzut Shoper - order Shoper \u0027 + shopId;\nconst taskDescription = [\n  \u0027Workflow SH-A_Shoper_Platnosc_Odrzucona zatrzymal sie na bledzie.\u0027,\n  \u0027\u0027,\n  \u0027Shoper order: \u0027 + shopId,\n  \u0027Blad: \u0027 + errMsg,\n  \u0027Wykonanie n8n: \u0027 + execId,\n  \u0027\u0027,\n  \u0027Do wykonania recznie:\u0027,\n  \u00271. Znajdz zamowienie BL po Shoper ID \u0027 + shopId + \u0027 (filter_external_order_id).\u0027,\n  \u00272. Sprawdz w Fakturowni czy proforma juz powstala.\u0027,\n  \u00273. Jesli nie - wystaw recznie proforme z pozycjami z zamowienia BL.\u0027,\n  \u00274. Pobierz PDF i wyslij mailem do klienta.\u0027,\n  \u00275. Zapisz link/PDF w polu BL 35897.\u0027\n].join(\u0027\\n\u0027);\n\nreturn [{ json: { taskName, taskDescription, priority: 2, status: \u0027open\u0027 } }];"
