                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "const order = $input.first().json;\nconst orderId = order.order_id;\nconst orderNumber = order.order_id;\n\nfunction toLocalISO(d) {\n  const fmt = new Intl.DateTimeFormat(\u0027en-CA\u0027, { timeZone: \u0027Europe/Warsaw\u0027, year: \u0027numeric\u0027, month: \u00272-digit\u0027, day: \u00272-digit\u0027 });\n  return fmt.format(d);\n}\nconst today = new Date();\nconst issueDate = toLocalISO(today);\nconst due = new Date(today.getTime() + 7 * 24 * 60 * 60 * 1000);\nconst paymentTo = toLocalISO(due);\n\nconst buyerName = (order.invoice_company || \u0027\u0027).trim() || order.invoice_fullname || order.delivery_fullname || \u0027Klient\u0027;\nconst buyerEmail = order.email || order.delivery_email || order.invoice_email || \u0027\u0027;\n\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027proforma\u0027,\n    place: \u0027Radzionkow\u0027,\n    issue_date: issueDate,\n    sell_date: issueDate,\n    payment_to: paymentTo,\n    buyer_name: buyerName,\n    buyer_tax_no: order.invoice_nip || \u0027\u0027,\n    buyer_post_code: order.invoice_postcode || \u0027\u0027,\n    buyer_city: order.invoice_city || \u0027\u0027,\n    buyer_street: order.invoice_address || \u0027\u0027,\n    buyer_country: order.invoice_country_code || \u0027PL\u0027,\n    buyer_email: buyerEmail,\n    description: \u0027Doplata za ponowna wysylke zamowienia \u0027 + orderNumber,\n    internal_note: \u0027BL: \u0027 + orderId,\n    payment_type: \u0027transfer\u0027,\n    positions: [{\n      name: \u0027Doplata za ponowna wysylke kurierem\u0027,\n      tax: 23,\n      quantity: 1,\n      quantity_unit: \u0027szt\u0027,\n      total_price_gross: 20.00\n    }]\n  },\n  _order_id: orderId,\n  _order_number: orderNumber,\n  _email: buyerEmail\n};\n\nreturn [{ json: payload }];"
                                     },
                      "notes":  "Mapping BL -\u003e Fakturownia invoice. kind=proforma, 20 PLN brutto VAT 23%, payment_to=+7 dni. internal_note \u0027BL: \u003corder_id\u003e\u0027 jako slad audytowy."
                  },
