                      "parameters":  {
                                         "language":  "javaScript",
                                         "jsCode":  "const oid = $(\u0027Odbierz-Webhook\u0027).first().json.query.order_id;\nconst raw = $input.first().json;\nconst errMsg = (raw.error \u0026\u0026 (raw.error.message || raw.error)) || raw.message || JSON.stringify(raw).slice(0, 500);\nconst execId = $execution.id;\n\nconst taskName = \u0027[DZ-A BLAD] Proforma doplaty - order BL \u0027 + oid;\nconst taskDescription = [\n  \u0027Workflow DZ-A_Doplata_Zwrot zatrzymal sie na bledzie.\u0027,\n  \u0027\u0027,\n  \u0027Order BL: \u0027 + oid,\n  \u0027Blad: \u0027 + errMsg,\n  \u0027Wykonanie n8n: \u0027 + execId,\n  \u0027\u0027,\n  \u0027Do wykonania recznie:\u0027,\n  \u00271. Sprawdz w Fakturowni czy proforma juz powstala (filtr po internal_note: BL: \u0027 + oid + \u0027).\u0027,\n  \u00272. Jesli nie - wystaw recznie proforme 20 zl, opis \"Doplata za ponowna wysylke zamowienia \u0027 + oid + \u0027\".\u0027,\n  \u00273. Pobierz PDF i wyslij mailem do klienta (sprawdz email w BL).\u0027,\n  \u00274. Zapisz link do PDF w polu BL zamowienia (Proforma doplata zwrot).\u0027\n].join(\u0027\\n\u0027);\n\nreturn [{ json: { taskName, taskDescription, priority: 2, status: \u0027open\u0027 } }];"
