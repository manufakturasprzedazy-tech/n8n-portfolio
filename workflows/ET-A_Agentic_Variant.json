                                         "jsCode":  "const j = $json;\nconst headers = (j.payload \u0026\u0026 j.payload.headers) || [];\nconst h = (name) =\u003e { const x = headers.find(hh =\u003e (hh.name||\u0027\u0027).toLowerCase() === name); return x ? x.value : \u0027\u0027; };\nconst subject = j.subject ?? j.Subject ?? h(\u0027subject\u0027) ?? \u0027(brak tematu)\u0027;\nconst from = j.from ?? j.From ?? h(\u0027from\u0027) ?? \u0027\u0027;\nconst b64 = (data) =\u003e { try { return Buffer.from(String(data).replace(/-/g,\u0027+\u0027).replace(/_/g,\u0027/\u0027), \u0027base64\u0027).toString(\u0027utf8\u0027); } catch (e) { return \u0027\u0027; } };\nconst acc = { plain: \u0027\u0027, html: \u0027\u0027 };\nconst walk = (part) =\u003e {\n  if (!part) return;\n  const mt = part.mimeType || \u0027\u0027;\n  if (part.body \u0026\u0026 part.body.data) {\n    if (mt === \u0027text/plain\u0027) acc.plain += b64(part.body.data);\n    else if (mt === \u0027text/html\u0027) acc.html += b64(part.body.data);\n  }\n  if (Array.isArray(part.parts)) part.parts.forEach(walk);\n};\nif (j.payload) walk(j.payload);\nconst stripHtml = (s) =\u003e String(s).replace(/\u003cstyle[\\s\\S]*?\u003c\\/style\u003e/gi,\u0027 \u0027).replace(/\u003cscript[\\s\\S]*?\u003c\\/script\u003e/gi,\u0027 \u0027).replace(/\u003c[^\u003e]+\u003e/g,\u0027 \u0027).replace(/\u0026nbsp;/gi,\u0027 \u0027).replace(/\u0026amp;/gi,\u0027\u0026\u0027).replace(/[ \\t]+/g,\u0027 \u0027).trim();\nlet bodyText = (acc.plain || j.text || \u0027\u0027).trim();\nif (!bodyText) { const html = acc.html || j.html || \u0027\u0027; if (html) bodyText = stripHtml(html); }\nif (!bodyText) bodyText = j.snippet || \u0027\u0027;\nconst messageId = j.id ?? j.messageId ?? \u0027\u0027;\nconst threadId = j.threadId ?? \u0027\u0027;\nreturn { json: { subject, from, bodyText, messageId, threadId } };"
                                     },
