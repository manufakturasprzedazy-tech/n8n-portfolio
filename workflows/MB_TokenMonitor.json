                      "notes":  "Airtable - list tables. Health check. Brak limitu monitoringu (Airtable dostepny zawsze)."
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Aggreguje wyniki wszystkich health checks i identyfikuje problemy.\n// Threshold values configurable here.\n\nconst openai = $(\u0027Check OpenAI Usage\u0027).first().json;\nconst perplexity = $(\u0027Check Perplexity Usage\u0027).first().json;\nconst json2video = $(\u0027Check json2video\u0027).first().json;\nconst meta = $(\u0027Check Meta Token\u0027).first().json;\nconst buffer = $(\u0027Check Buffer\u0027).first().json;\nconst airtable = $(\u0027Check Airtable\u0027).first().json;\n\nconst alerts = [];\n\n// OpenAI - check spending vs limit (TODO konkretne progi)\nif (openai.error) alerts.push({service: \u0027OpenAI\u0027, issue: \u0027API error\u0027, deeplink: \u0027https://platform.openai.com/account/billing\u0027});\n\n// Perplexity\nif (perplexity.error) alerts.push({service: \u0027Perplexity\u0027, issue: \u0027API error\u0027, deeplink: \u0027https://www.perplexity.ai/settings/api\u0027});\n\n// json2video - watch for low credits\nif (json2video.error) alerts.push({service: \u0027json2video\u0027, issue: \u0027API error\u0027, deeplink: \u0027https://json2video.com/dashboard\u0027});\nelse if (json2video.credits \u0026\u0026 json2video.credits \u003c 50) {\n  alerts.push({service: \u0027json2video\u0027, issue: `Niski balans: ${json2video.credits} kredytow`, deeplink: \u0027https://json2video.com/dashboard\u0027});\n}\n\n// Meta token - 401 means token revoked\nif (meta.error || (meta.error \u0026\u0026 meta.error.code === 190)) {\n  alerts.push({service: \u0027Meta (FB/IG)\u0027, issue: \u0027Token uniewazniony!\u0027, deeplink: \u0027https://business.facebook.com/settings/system-users\u0027});\n}\n\n// Buffer\nif (buffer.error || (Array.isArray(buffer) === false \u0026\u0026 !buffer[0])) {\n  alerts.push({service: \u0027Buffer\u0027, issue: \u0027Token wygasl/blad\u0027, deeplink: \u0027https://publish.buffer.com/\u0027});\n}\n\n// Airtable\nif (airtable.error) alerts.push({service: \u0027Airtable\u0027, issue: \u0027API error\u0027, deeplink: \u0027https://airtable.com/create/tokens\u0027});\n\nreturn [{\n  json: {\n    has_alerts: alerts.length \u003e 0,\n    alerts,\n    total_services: 6,\n    issues_count: alerts.length,\n    timestamp: new Date().toISOString()\n  }\n}];"
                                     },
