                  {
                      "parameters":  {
                                         "jsCode":  "// Builduje Telegram message z inline keyboard \u0027Doladuj teraz\u0027 deeplinkami.\nconst data = $input.first().json;\n\nlet text = `⚠️ *Monitoring uslug M\u0026B Investment*\n\nWykryto problemy z ${data.issues_count} z ${data.total_services} uslug:\n\n`;\n\nconst inlineKeyboard = [];\n\ndata.alerts.forEach(a =\u003e {\n  text += `• *${a.service}*: ${a.issue}\\n`;\n  inlineKeyboard.push([{text: `💳 Doladuj/napraw ${a.service}`, url: a.deeplink}]);\n});\n\ntext += `\\n_Sprawdzono: ${data.timestamp}_`;\n\nreturn [{\n  json: {\n    chat_id: \u0027PLACEHOLDER_NICOLAS_CHAT_ID\u0027,\n    text,\n    reply_markup: JSON.stringify({inline_keyboard: inlineKeyboard})\n  }\n}];"
                                     },
