                  {
                      "parameters":  {
                                         "jsCode":  "const ALLOWED_STATUS_IDS = [-1,-2,-3,-4,-5,-6];\nconst orders = ($input.all()[0] \u0026\u0026 $input.all()[0].json \u0026\u0026 $input.all()[0].json.orders) || [];\nconst filtered = orders.filter(function(o){\n  var tradycyjny = (o.payment_method || \u0027\u0027).toLowerCase().indexOf(\u0027tradycyjny\u0027) !== -1;\n  var oplacony = parseInt(o.payment_done, 10) === 1;\n  var dobryStatus = ALLOWED_STATUS_IDS.indexOf(o.order_status_id) !== -1;\n  return tradycyjny \u0026\u0026 oplacony \u0026\u0026 dobryStatus;\n});\nreturn filtered.map(function(o){ return { json: o }; });"
                                     },
