                                         "jsCode":  "const order = $json;\nconst paid = DateTime.fromSeconds(order.date_confirmed, { zone: \u0027Europe/Warsaw\u0027 });\nconst issueDate = paid.endOf(\u0027month\u0027).toFormat(\u0027yyyy-MM-dd\u0027);\nconst payload = {\n  api_token: \u0027TODO_FAKTUROWNIA_TOKEN\u0027,\n  invoice: {\n    kind: \u0027advance\u0027,\n    issue_date: issueDate,\n    sell_date: issueDate,\n    payment_to: issueDate,\n    buyer_name: order.delivery_fullname || order.invoice_fullname,\n    buyer_tax_no: order.invoice_nip || \u0027\u0027,\n    buyer_post_code: order.invoice_postcode || \u0027\u0027,\n    buyer_city: order.invoice_city || \u0027\u0027,\n    buyer_street: order.invoice_address || \u0027\u0027,\n    buyer_country: order.invoice_country_code || \u0027PL\u0027,\n    buyer_email: order.email || \u0027\u0027,\n    positions: [{\n      name: \u0027Zaliczka do zamowienia nr \u0027 + order.order_id,\n      tax: 23,\n      total_price_gross: order.order_total_gross || 0,\n      quantity: 1\n    }],\n    description: \u0027Zaliczka 100% do zamowienia BaseLinker nr \u0027 + order.order_id,\n    payment_type: \u0027transfer\u0027,\n    status: \u0027paid\u0027\n  },\n  _order_id: order.order_id\n};\nreturn [{ json: payload }];"
                                     },
