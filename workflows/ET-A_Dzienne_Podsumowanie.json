                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "jsCode":  "// Zlicza przetworzone maile po etykietach AI/* z ostatnich 24h.\nconst LABELS = { Label_1:\u0027Oferty\u0027, Label_2:\u0027Klient\u0027, Label_3:\u0027Reklamacje\u0027, Label_4:\u0027Faktury\u0027, Label_5:\u0027Wspolpraca\u0027, Label_6:\u0027Rekrutacja\u0027, Label_7:\u0027Spam\u0027, Label_8:\u0027Inne\u0027 };\nconst items = $input.all();\nconst counts = {}; let total = 0, urgent = 0, injection = 0;\nfor (const it of items) {\n  const ids = it.json.labelIds || it.json.labels || [];\n  let isAI = false;\n  for (const [lid, name] of Object.entries(LABELS)) { if (ids.includes(lid)) { counts[name] = (counts[name]||0)+1; isAI = true; } }\n  if (ids.includes(\u0027Label_9\u0027)) urgent++;\n  if (ids.includes(\u0027Label_10\u0027)) injection++;\n  if (isAI || ids.includes(\u0027Label_9\u0027) || ids.includes(\u0027Label_10\u0027)) total++;\n}\nconst order = [\u0027Oferty\u0027,\u0027Klient\u0027,\u0027Reklamacje\u0027,\u0027Faktury\u0027,\u0027Wspolpraca\u0027,\u0027Rekrutacja\u0027,\u0027Spam\u0027,\u0027Inne\u0027];\nconst lines = order.filter(k=\u003ecounts[k]).map(k=\u003e`• ${k}: ${counts[k]}`).join(\u0027\\n\u0027) || \u0027• (brak w tym okresie)\u0027;\nconst text = \u0027:bar_chart: *Dzienne podsumowanie triazu skrzynki* (ostatnie 24h)\\n\u0027 +\n  `*Przetworzone maile:* ${total}\\n` +\n  `*Pilne (AI/PILNE):* ${urgent}\\n` +\n  `*Injection/phishing:* ${injection}\\n` +\n  `*Wg kategorii:*\\n${lines}\\n` +\n  (total === 0 ? \u0027\\n:warning: _Zero maili w 24h — sprawdz czy trigger i skrzynka dzialaja._\u0027 : \u0027\u0027);\nreturn [{ json: { text, total, urgent, injection, counts } }];"
                                     }
