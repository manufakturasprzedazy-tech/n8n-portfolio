                  },
                  {
                      "parameters":  {
                                         "promptType":  "define",
                                         "text":  "=Jesteś asystentem planowania dnia dla osoby z ADHD pracującej na nocnej zmianie (21:00-06:00).\n\nAktualne dane:\n- Dzień #{{ $json.dayNumber }}\n- Current Streak: {{ $json.playerStats.currentStreak || 0 }} 🔥\n- Data: {{ $json.date }}\n\nDostępne subtaski do zaplanowania:\n{{ JSON.stringify($json.subtasks, null, 2) }}\n\nCodzienne nawyki:\n{{ JSON.stringify($json.habits, null, 2) }}\n\nTwoje zadanie:\n1. Wybierz maksymalnie 6 subtasków (priorytet: urgent \u003e high \u003e normal \u003e low)\n2. Rozłóż je w time-boxingu 13:30-20:00:\n   - 13:30-14:30 🟢 Rozgrzewka (low priority)\n   - 14:30-17:00 🔴 Deep Work Block 1 (urgent/high priority)\n   - 17:00-17:30 ☕ Przerwa\n   - 17:30-19:30 ⚡ Deep Work Block 2 (high/normal priority)\n   - 19:30-20:00 📋 Wrap-up (drobne rzeczy)\n3. Wygeneruj motywacyjny cytat od współczesnego przedsiębiorcy/lidera (Elon Musk, Steve Jobs, Naval Ravikant, Tim Ferriss, James Clear, etc.)\n\nOdpowiedz w formacie JSON:\n{\n  \"motto\": \"Cytat motywacyjny - Autor\",\n  \"timeBoxing\": {\n    \"rozgrzewka\": [\"nazwa subtaska 1\"],\n    \"deepWork1\": [\"nazwa subtaska 2\", \"nazwa subtaska 3\"],\n    \"deepWork2\": [\"nazwa subtaska 4\", \"nazwa subtaska 5\"],\n    \"wrapup\": [\"nazwa subtaska 6\"]\n  },\n  \"selectedTasks\": [\"nazwa1\", \"nazwa2\", ...],\n  \"habits\": [\"🎧 Angielskie podcasty\", \"📚 Nauka słówek\"]\n}",
                                         "options":  {
                                                         "systemMessage":  "Jesteś ekspertem od produktywności i planowania dnia. Odpowiadaj TYLKO w formacie JSON bez dodatkowego tekstu. Cytaty muszą być prawdziwe od znanych osób."
                                                     }
                                     },
                      "id":  "ai-agent",
                      "name":  "AI Planner",
                      "type":  "@n8n/n8n-nodes-langchain.agent",
                      "typeVersion":  3.1,
                      "position":  [
                                       896,
                                       48
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const aiOutput = $input.first().json.output;\n\n// Parsuj JSON z odpowiedzi AI\nlet plan;\ntry {\n  // Usuń markdown code blocks jeśli są\n  let cleanOutput = aiOutput.replace(/```json\\n?/g, \u0027\u0027).replace(/```\\n?/g, \u0027\u0027).trim();\n  plan = JSON.parse(cleanOutput);\n} catch (e) {\n  // Fallback - podstawowy plan\n  plan = {\n    motto: \"Sukces to suma małych wysiłków powtarzanych dzień po dniu. - Robert Collier\",\n    timeBoxing: {\n      rozgrzewka: [],\n      deepWork1: [],\n      deepWork2: [],\n      wrapup: []\n    },\n    selectedTasks: [],\n    habits: [\"🎧 Angielskie podcasty\", \"📚 Nauka słówek\"]\n  };\n}\n\n// Pobierz dane z poprzedniego kroku\nconst inputData = $(\u0027Prepare AI Input\u0027).first().json;\nconst taskMapping = inputData.taskMapping || {};\n\n// Przygotuj listę dla checklisty Z MAPOWANIEM\nconst checklistItemsWithMapping = [];\n\nfor (const taskName of plan.selectedTasks) {\n  const mapping = taskMapping[taskName];\n  checklistItemsWithMapping.push({\n    name: taskName,\n    originalTaskId: mapping?.id || null,\n    originalListId: mapping?.listId || null,\n    isHabit: mapping?.isHabit || false\n  });\n}\n\n// Separator\nchecklistItemsWithMapping.push({\n  name: \u0027───────────────\u0027,\n  originalTaskId: null,\n  isSeparator: true\n});\n\n// Nawyki\nfor (const habitName of plan.habits) {\n  const mapping = taskMapping[habitName];\n  checklistItemsWithMapping.push({\n    name: habitName,\n    originalTaskId: mapping?.id || null,\n    isHabit: true\n  });\n}\n\n// Formatuj wiadomość Telegram\nconst dayNumber = inputData.dayNumber;\nconst streak = inputData.playerStats.currentStreak || 0;\nconst date = inputData.date;\n\nlet telegramMessage = `🌅 *Dzień #${dayNumber}* | Streak: ${streak} 🔥\\n\\n`;\ntelegramMessage += `💡 _\"${plan.motto}\"_\\n\\n`;\ntelegramMessage += `📋 *Twój plan na dziś:*\\n\\n`;\ntelegramMessage += `⏰ *TIME-BOXING:*\\n`;\ntelegramMessage += `*13:30-14:30* 🟢 Rozgrzewka\\n`;\nfor (const task of plan.timeBoxing.rozgrzewka || []) {\n  telegramMessage += `• ${task}\\n`;\n}\ntelegramMessage += `\\n*14:30-17:00* 🔴 Deep Work Block 1\\n`;\nfor (const task of plan.timeBoxing.deepWork1 || []) {\n  telegramMessage += `• ${task}\\n`;\n}\ntelegramMessage += `\\n*17:30-19:30* ⚡ Deep Work Block 2\\n`;\nfor (const task of plan.timeBoxing.deepWork2 || []) {\n  telegramMessage += `• ${task}\\n`;\n}\ntelegramMessage += `\\n*19:30-20:00* 📋 Wrap-up\\n`;\nfor (const task of plan.timeBoxing.wrapup || []) {\n  telegramMessage += `• ${task}\\n`;\n}\ntelegramMessage += `\\n🎧 *W pracy (21:00-06:00):*\\n`;\nfor (const habit of plan.habits || []) {\n  telegramMessage += `• ${habit}\\n`;\n}\ntelegramMessage += `\\nPowodzenia! 💪`;\n\n// Task description - ZAWIERA UKRYTE MAPOWANIE\nlet taskDescription = `🌅 Dzień #${dayNumber} | Streak: ${streak} 🔥\\n\\n`;\ntaskDescription += `💡 ${plan.motto}\\n\\n`;\ntaskDescription += `⏰ TIME-BOXING:\\n`;\ntaskDescription += `13:30-14:30 🟢 Rozgrzewka\\n`;\ntaskDescription += `14:30-17:00 🔴 Deep Work Block 1\\n`;\ntaskDescription += `17:00-17:30 ☕ Przerwa\\n`;\ntaskDescription += `17:30-19:30 ⚡ Deep Work Block 2\\n`;\ntaskDescription += `19:30-20:00 📋 Wrap-up\\n\\n`;\n\n// DODAJ UKRYTE MAPOWANIE NA KOŃCU DESCRIPTION\ntaskDescription += `\\n\u003c!-- TASK_MAPPING_JSON\\n${JSON.stringify(checklistItemsWithMapping)}\\nEND_TASK_MAPPING --\u003e`;\n\nreturn [{\n  json: {\n    plan: plan,\n    checklistItems: checklistItemsWithMapping.map(i =\u003e i.name),\n    checklistItemsWithMapping: checklistItemsWithMapping,\n    taskMapping: taskMapping,\n    telegramMessage: telegramMessage,\n    taskDescription: taskDescription,\n    taskName: `📅 ${date} - Daily Quest`,\n    dayNumber: dayNumber,\n    streak: streak,\n    date: date\n  }\n}];"
                                     },
