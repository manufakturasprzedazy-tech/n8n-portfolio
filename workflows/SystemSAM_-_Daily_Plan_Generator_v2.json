                                         "jsCode":  "// Pobierz checklist ID z poprzedniego kroku\nconst checklistResponse = $input.first().json;\nconst checklistId = checklistResponse.checklist?.id;\n\nif (!checklistId) {\n  throw new Error(\u0027Checklist ID not found\u0027);\n}\n\n// Pobierz items z Parse AI Response\nconst parseData = $(\u0027Parse AI Response\u0027).first().json;\nconst items = parseData.checklistItems || [];\n\n// Zwróć OSOBNE itemy dla każdego elementu checklisty\nreturn items.map(itemName =\u003e ({\n  json: {\n    itemName: itemName,\n    checklistId: checklistId,\n    telegramMessage: parseData.telegramMessage\n  }\n}));"
