                                       448,
                                       48
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Pobierz dane z poprzednich nodów\nconst allItems = $input.all();\n\nlet subtasks = [];\nlet habits = [];\nlet playerStats = {};\n\nfor (const item of allItems) {\n  const data = item.json;\n  \n  // Subtaski - taski które mają parent (są subtaskami)\n  if (data.tasks \u0026\u0026 Array.isArray(data.tasks)) {\n    for (const task of data.tasks) {\n      // Sprawdź czy to subtask (ma parent) i czy ma odpowiedni tag\n      const hasSubtaskTag = task.tags?.some(t =\u003e t.name.toLowerCase().startsWith(\u0027subtask-\u0027));\n      const isOpen = [\u0027open\u0027, \u0027to do\u0027, \u0027in progress\u0027].includes(task.status?.status?.toLowerCase());\n      \n      if (hasSubtaskTag \u0026\u0026 isOpen) {\n        subtasks.push({\n          id: task.id,\n          name: task.name,\n          priority: task.priority?.priority || \u0027normal\u0027,\n          priorityOrder: task.priority?.orderindex || 3,\n          tags: task.tags?.map(t =\u003e t.name) || [],\n          parentTag: task.tags?.find(t =\u003e t.name.toLowerCase().startsWith(\u0027subtask-\u0027))?.name || \u0027\u0027,\n          listName: task.list?.name || \u0027\u0027,\n          listId: task.list?.id || \u0027\u0027,\n          url: task.url\n        });\n      }\n    }\n  }\n  \n  // Habits z listy Master Habits (sprawdź po list ID)\n  if (data.tasks \u0026\u0026 Array.isArray(data.tasks)) {\n    for (const task of data.tasks) {\n      const isFromHabitsList = task.list?.id === \u0027901519552364\u0027;\n      if (isFromHabitsList) {\n        habits.push({\n          id: task.id,\n          name: task.name,\n          url: task.url\n        });\n      }\n    }\n  }\n  \n  // Player Stats - bezpośrednio z pojedynczego taska\n  if (data.custom_fields \u0026\u0026 data.id === \u002786c7ec2db\u0027) {\n    for (const field of data.custom_fields) {\n      if (field.name === \u0027Current Streak\u0027) playerStats.currentStreak = parseInt(field.value) || 0;\n      if (field.name === \u0027Best Streak\u0027) playerStats.bestStreak = parseInt(field.value) || 0;\n      if (field.name === \u0027Total Days Completed\u0027) playerStats.totalDays = parseInt(field.value) || 0;\n      if (field.name === \u0027Total XP\u0027) playerStats.totalXP = parseInt(field.value) || 0;\n    }\n  }\n}\n\n// Sortuj subtaski po priorytecie (urgent=1, high=2, normal=3, low=4)\nsubtasks.sort((a, b) =\u003e a.priorityOrder - b.priorityOrder);\n\n// Ogranicz do 6 subtasków\nconst selectedSubtasks = subtasks.slice(0, 6);\n\n// KLUCZOWE: Stwórz mapowanie name → task info\nconst taskMapping = {};\nfor (const task of selectedSubtasks) {\n  taskMapping[task.name] = {\n    id: task.id,\n    listId: task.listId,\n    url: task.url\n  };\n}\n\n// Dodaj nawyki do mapowania\nfor (const habit of habits) {\n  taskMapping[habit.name] = {\n    id: habit.id,\n    listId: \u0027901519552364\u0027,\n    url: habit.url,\n    isHabit: true\n  };\n}\n\n// Jeśli nie ma nawyków z API, użyj domyślnych\nif (habits.length === 0) {\n  habits = [\n    {id: \u0027habit-podcast\u0027, name: \u0027🎧 Angielskie podcasty\u0027},\n    {id: \u0027habit-slowka\u0027, name: \u0027📚 Nauka słówek\u0027}\n  ];\n  taskMapping[\u0027🎧 Angielskie podcasty\u0027] = {id: \u0027habit-podcast\u0027, isHabit: true};\n  taskMapping[\u0027📚 Nauka słówek\u0027] = {id: \u0027habit-slowka\u0027, isHabit: true};\n}\n\nconst dayNumber = (playerStats.totalDays || 0) + 1;\n\nreturn [{\n  json: {\n    subtasks: selectedSubtasks,\n    habits: habits,\n    playerStats: playerStats,\n    taskMapping: taskMapping,\n    dayNumber: dayNumber,\n    date: new Date().toISOString().split(\u0027T\u0027)[0]\n  }\n}];"
                                     },
