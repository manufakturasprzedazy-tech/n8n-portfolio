                                                         }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const task = $input.first().json;\n\n// Znajdź Last Active Date\nlet lastActiveTimestamp = null;\nfor (const field of task.custom_fields || []) {\n  if (field.name === \u0027Last Active Date\u0027 \u0026\u0026 field.value) {\n    lastActiveTimestamp = parseInt(field.value);\n  }\n}\n\n// Sprawdź czy dzisiaj już zaktualizowano\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst todayTimestamp = today.getTime();\n\n// Jeśli last active jest z dzisiaj (po 00:00), znaczy że już odpowiedział\nconst alreadyUpdatedToday = lastActiveTimestamp \u0026\u0026 lastActiveTimestamp \u003e= todayTimestamp;\n\nreturn [{\n  json: {\n    alreadyUpdatedToday: alreadyUpdatedToday,\n    lastActiveTimestamp: lastActiveTimestamp,\n    todayTimestamp: todayTimestamp,\n    needsReminder: !alreadyUpdatedToday\n  }\n}];"
                                     },
