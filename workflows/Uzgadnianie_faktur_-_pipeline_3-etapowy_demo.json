                      "name":  "Uruchom recznie",
                      "type":  "n8n-nodes-base.manualTrigger",
                      "typeVersion":  1,
                      "position":  [
                                       -2080,
                                       -48
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// \u003e\u003e\u003e USTAW SWOJE: wklej klucz OpenRouter i wybierz model \u003c\u003c\u003c\nconst apiKey = \"sk-or-REPLACE_WITH_YOUR_KEY\";\nconst model  = \"minimax/minimax-m2.1\";   // tani zwyciezca naszych testow (mozesz dac inny slug z openrouter.ai/models)\n\n// REJESTR FAKTUR (ksiegi firmy, po polsku)\nconst rejestr = [\n  {id:\"F01\", numer:\"FV 0001/2026\", kontrahent:\"Mueller GmbH\",        kwota:\"1 234,56\",  waluta:\"EUR\", data:\"12.03.2026\"},\n  {id:\"F02\", numer:\"FV 0002/2026\", kontrahent:\"Northwind Ltd\",       kwota:\"980,00\",    waluta:\"EUR\", data:\"14.03.2026\"},\n  {id:\"F03\", numer:\"FV 0003/2026\", kontrahent:\"Stalmex Sp. z o.o.\",  kwota:\"2 500,00\",  waluta:\"PLN\", data:\"15.03.2026\"},\n  {id:\"F04\", numer:\"FV 0004/2026\", kontrahent:\"Stalmex Sp. z o.o.\",  kwota:\"2 500,00\",  waluta:\"PLN\", data:\"16.03.2026\"}, // BLIZNIACZA kwota z F03\n  {id:\"F05\", numer:\"FV 0005/2026\", kontrahent:\"Drewno-Pol S.A.\",     kwota:\"12 300,00\", waluta:\"PLN\", data:\"18.03.2026\"},\n  {id:\"F06\", numer:\"FV 0006/2026\", kontrahent:\"Shenzhen Yongtai\",    kwota:\"4 500,00\",  waluta:\"USD\", data:\"20.03.2026\"},\n];\n\n// WYCIAG BANKOWY (przelewy w formacie jezyka platnika - pulapki formatow/jezykow)\nconst przelewy = [\n  {id:\"T1\", data:\"12.04.2026\", kwota:\"1.234,56\", waluta:\"EUR\", nadawca:\"Mueller GmbH\",       tytul:\"Zahlung Rechnung 1/2026\"},      // DE -\u003e F01\n  {id:\"T2\", data:\"04/15/2026\", kwota:\"980.00\",   waluta:\"EUR\", nadawca:\"Northwind Ltd\",      tytul:\"payment inv 2\"},                // EN -\u003e F02\n  {id:\"T3\", data:\"16.04.2026\", kwota:\"2 500,00\", waluta:\"PLN\", nadawca:\"Stalmex Sp. z o.o.\", tytul:\"FV 0004/2026\"},                 // bliznacza kwota -\u003e F04 (po numerze!)\n  {id:\"T4\", data:\"18.04.2026\", kwota:\"4,500.00\", waluta:\"USD\", nadawca:\"Shenzhen Yongtai\",   tytul:\"发票付款 6/2026\"}, // CN -\u003e F06\n  {id:\"T5\", data:\"20.04.2026\", kwota:\"500,00\",   waluta:\"PLN\", nadawca:\"Jan Kowalski\",       tytul:\"zwrot kaucji\"},                 // SZUM -\u003e brak dopasowania\n];\n\nconst registerText = rejestr.map(f =\u003e\n  `${f.id} | ${f.numer} | ${f.kontrahent} | ${f.kwota} ${f.waluta} | ${f.data}`).join(\"\\n\");\n\nreturn przelewy.map(tr =\u003e {\n  const transferLine = `ID ${tr.id} | Data ${tr.data} | Kwota ${tr.kwota} ${tr.waluta} | Nadawca ${tr.nadawca} | Tytul: ${tr.tytul}`;\n  const body1 = {\n    model, temperature: 0, response_format: { type: \"json_object\" },\n    messages: [{ role: \"user\", content:\n`Znormalizuj ten wiersz wyciagu bankowego (NIE dopasowuj jeszcze faktury).\n- Kwote zamien na liczbe z kropka: 1.234,56 (DE) i 1,234.56 (EN) i 1 234,56 (PL) -\u003e 1234.56\n- Date na YYYY-MM-DD (uwaga MM/DD vs DD.MM)\n- Z tytulu wyciagnij numer faktury (lub null)\nZwroc TYLKO JSON:\n{\"przelew_id\":\"${tr.id}\",\"kwota\":0.00,\"waluta\":\"...\",\"data\":\"YYYY-MM-DD\",\"numer_z_tytulu\":\"...\",\"nadawca\":\"...\"}\n\nWIERSZ:\n${transferLine}` }]\n  };\n  return { json: { apiKey, model, registerText, transfer: tr, transferLine, body1 } };\n});\n"
                                     },
                      "id":  "c341a9cf-9220-4a7b-8dc8-ea05a0cc9c08",
