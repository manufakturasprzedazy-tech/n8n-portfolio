                  {
                      "parameters":  {
                                         "jsCode":  "const rozliczenia = [];\nconst niedopasowane = [];\nfor (const it of $input.all()) {\n  const w = it.json.wynik || {};\n  const tid = it.json.transfer.id;\n  if (w.dopasowany \u0026\u0026 (w.przypisania || []).length) {\n    rozliczenia.push({ przelew_id: tid, status: w.status || \"exact\", przypisania: w.przypisania });\n  } else {\n    niedopasowane.push(tid);\n  }\n}\nreturn [{ json: { rozliczenia, niedopasowane, liczba_przelewow: $input.all().length } }];\n"
                                     },
