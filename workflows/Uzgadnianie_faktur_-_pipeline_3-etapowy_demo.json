                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "let match = {};\ntry { match = JSON.parse($json.choices[0].message.content); } catch (e) { match = { dopasowany: false }; }\nconst base = $(\u0027Etap 1: Normalizacja - parsuj\u0027).item.json;\nconst body3 = {\n  model: base.model, temperature: 0, response_format: { type: \"json_object\" },\n  messages: [{ role: \"user\", content:\n`Sprawdz krytycznie ponizsze dopasowanie przelewu do faktury.\nMasz rejestr, znormalizowany przelew i PROPOZYCJE. Jesli poprawna - zwroc ja 1:1.\nJesli blad - zwroc POPRAWIONA. Uwaga: zgodnosc waluty, kwota co do grosza,\nbliznacze kwoty (rozroznij po numerze), czy aby nie powinno byc \"dopasowany\": false.\nZwroc TYLKO JSON w tym samym formacie.\n\nREJESTR FAKTUR:\n${base.registerText}\n\nPRZELEW (znormalizowany):\n${JSON.stringify(base.norm)}\n\nPROPOZYCJA DOPASOWANIA:\n${JSON.stringify(match)}` }]\n};\nreturn { json: { ...base, match, body3 } };\n"
                                     },
