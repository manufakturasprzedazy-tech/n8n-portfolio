                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "let wynik = {};\ntry { wynik = JSON.parse($json.choices[0].message.content); } catch (e) { wynik = { dopasowany: false }; }\nconst base = $(\u0027Etap 2: Dopasowanie - parsuj\u0027).item.json;\nreturn { json: { ...base, wynik } };\n"
                                     },
                      "id":  "151a7acc-9be9-42e8-964a-0f15c862ecd9",
                      "name":  "Etap 3: Weryfikacja - parsuj",
                      "type":  "n8n-nodes-base.code",
