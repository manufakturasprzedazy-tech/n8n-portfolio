                      "id":  "689dfbd1-6fe8-4233-9854-ac595b638f62",
                      "name":  "Etap 1: Normalizacja",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       -1648,
                                       -48
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "let norm = {};\ntry { norm = JSON.parse($json.choices[0].message.content); } catch (e) { norm = { _blad: \"parse\" }; }\nconst base = $(\u0027Dane demo + rozbij na przelewy\u0027).item.json;\nconst body2 = {\n  model: base.model, temperature: 0, response_format: { type: \"json_object\" },\n  messages: [{ role: \"user\", content:\n`Jestes ksiegowym. Masz REJESTR FAKTUR i jeden ZNORMALIZOWANY przelew.\nDopasuj go do faktury (lub faktur), albo oznacz brak dopasowania.\n- Dopasowuj po numerze, kwocie, kontrahencie i WALUCIE (waluty musza sie zgadzac).\n- Status: exact / czesciowa / zbiorcza / nadplata.\n- Bliznacze kwoty rozrozniaj po NUMERZE, nie po kwocie.\nZwroc TYLKO JSON:\n{\"przelew_id\":\"...\",\"dopasowany\":true,\"status\":\"exact\",\"przypisania\":[{\"faktura_id\":\"...\",\"kwota\":0.00}]}\nalbo: {\"przelew_id\":\"...\",\"dopasowany\":false,\"przypisania\":[]}\n\nREJESTR FAKTUR:\n${base.registerText}\n\nPRZELEW (znormalizowany):\n${JSON.stringify(norm)}` }]\n};\nreturn { json: { ...base, norm, body2 } };\n"
                                     },
